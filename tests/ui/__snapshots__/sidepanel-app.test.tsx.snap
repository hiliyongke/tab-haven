exports[`侧边栏 App（渲染输出基线） > 空态与降级横幅并存时的渲染树与基线一致 1`] = `"<main class="app flex h-full flex-col"><div class="search-bar"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search search-bar-icon h-4 w-4" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><input class="search-bar-input" placeholder="Search tabs in this window (title / URL / pinyin) · Ctrl+P / ⌘P for commands" aria-label="Search tabs" type="search" value=""></div><output class="sr-only" aria-live="polite"></output><div role="alert" class="mx-1 mb-1 flex items-start gap-2 rounded-lg border border-warn-200 bg-warn-50 px-3 py-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert mt-0.5 h-4 w-4 shrink-0 text-warn-600" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg><p class="min-w-0 flex-1 text-3xs leading-relaxed text-warn-700">Recent changes may not have been saved locally. Check whether browser storage is full, or whether extension permissions were revoked.</p></div><div class="px-1 py-0.5"><section aria-label="Fixed space" class="section-card module-shell fixed-area"><div class="section-head"><button type="button" class="toggle" aria-label="Fixed space" aria-expanded="true"><span class="head-leading" aria-hidden="true"><span class="h-3.5 w-0.5 shrink-0 rounded-full" style="background-color: var(--c-brand-500);"></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-3.5 w-3.5 transition-transform rotate-90" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></span><span class="title">Fixed space</span></button><span class="count-pill">0</span><span class="section-head-actions"><button type="button" class="row-action" title="New folder" aria-label="New folder"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><span class="sr-only">New folder</span></button></span></div><p class="fixed-area-empty">Click + to create a folder, or drop a tab/group here directly</p><div class="relative mt-1"><div><p class="px-1 pb-1.5 text-3xs font-medium text-gray-500">About pinned items</p><ul class="flex flex-col gap-1.5"><li class="flex items-start gap-2 rounded-lg bg-gray-50 px-2.5 py-2"><span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-md bg-accent-50 text-accent-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pin h-3 w-3" aria-hidden="true"><path d="M12 17v5"></path><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"></path></svg></span><div class="min-w-0"><p class="text-3xs font-semibold text-gray-700">Always-on tiles</p><p class="mt-0.5 text-3xs leading-snug text-gray-600">Pages you switch to often — drop onto the top tile bar for one-tap access</p></div></li><li class="flex items-start gap-2 rounded-lg bg-gray-50 px-2.5 py-2"><span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-md bg-accent-50 text-accent-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder h-3 w-3" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg></span><div class="min-w-0"><p class="text-3xs font-semibold text-gray-700">Folders</p><p class="mt-0.5 text-3xs leading-snug text-gray-600">Long-term containers — drop tabs or groups in to organize by topic</p></div></li><li class="flex items-start gap-2 rounded-lg bg-gray-50 px-2.5 py-2"><span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-md bg-accent-50 text-accent-600"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-anchor h-3 w-3" aria-hidden="true"><path d="M12 6v16"></path><path d="m19 13 2-1a9 9 0 0 1-18 0l2 1"></path><path d="M9 11h6"></path><circle cx="12" cy="4" r="2"></circle></svg></span><div class="min-w-0"><p class="text-3xs font-semibold text-gray-700">Browser-pinned tabs</p><p class="mt-0.5 text-3xs leading-snug text-gray-600">OS-level pins outside Tabs; shown here only as tiles</p></div></li></ul><p class="px-1 pt-1.5 text-3xs leading-snug text-gray-600">Native tab groups are browser groupings, not pinned items</p></div><button type="button" class="absolute right-1 top-0.5 shrink-0 rounded px-1.5 py-0.5 text-2xs font-medium text-gray-400 transition-base hover:bg-gray-100 hover:text-gray-600" title="Dismiss">Dismiss</button></div></section></div><div class="flex-1 overflow-y-auto px-1 py-0.5"><div class="flex flex-col items-center gap-1.5 px-2 py-6 text-center"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-500"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-4.5 w-4.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span><p class="text-xs font-medium text-gray-600">No tabs in this window yet</p><p class="max-w-52 text-3xs text-gray-600">New tabs appear here automatically; drag your go-to pages to the top always-on tiles for one-tap access.</p><button type="button" class="mt-1 rounded-lg border border-accent-300 bg-accent-50 px-3 py-1.5 text-2xs font-medium text-accent-700 transition-base hover:bg-accent-100">Open new tab</button></div></div><div class="add-tab-bar"><button type="button" class="add-tab-btn"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-4 w-4" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><span>New tab</span></button></div><footer class="flex shrink-0 flex-wrap items-center justify-between gap-x-2 gap-y-0.5 border-t border-gray-200 px-2.5 py-0.5 text-2xs text-gray-500"><span class="whitespace-nowrap"> <strong>0</strong> tabs</span><nav class="flex min-w-0 flex-wrap items-center gap-0.5" aria-label="Sidebar tools"><button type="button" class="relative inline-flex items-center justify-center gap-1 rounded transition-base hover:bg-gray-100 disabled:cursor-default disabled:opacity-50 min-h-6 min-w-6 p-1" title="Open command palette" aria-label="Open command palette"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-command h-4 w-4" aria-hidden="true"><path d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3"></path></svg><span class="icon-btn-label text-3xs leading-none">Commands</span></button><button type="bu