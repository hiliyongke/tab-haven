exports[`侧边栏 App（渲染输出基线） > 有标签时的渲染树与基线一致 1`] = `"<main class="app flex h-full flex-col"><div class="search-bar"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search search-bar-icon h-4 w-4" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><input class="search-bar-input" placeholder="Search tabs in this window (title / URL / pinyin) · Ctrl+P / ⌘P for commands" aria-label="Search tabs" type="search" value=""></div><output class="sr-only" aria-live="polite"></output><div class="px-1 py-0.5"><section aria-label="Fixed space" class="section-card module-shell fixed-area"><div class="section-head"><button type="button" class="toggle" aria-label="Fixed space" aria-expanded="true"><span class="head-leading" aria-hidden="true"><span class="h-3.5 w-0.5 shrink-0 rounded-full" style="background-color: var(--c-brand-500);"></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-3.5 w-3.5 transition-transform rotate-90" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></span><span class="title">Fixed space</span></button><span class="count-pill">0</span><span class="section-head-actions"><button type="button" class="row-action" title="New folder" aria-label="New folder"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><span class="sr-only">New folder</span></button></span></div><p class="fixed-area-empty">Click + to create a folder, or drop a tab/group here direct