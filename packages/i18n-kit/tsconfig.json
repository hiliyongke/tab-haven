{
  // 本包自带类型检查，与扩展同严格度（strict / noUncheckedIndexedAccess / noUnused*）。
  //
  // 扩展的 tsc 只检查被 import 引入的 i18n-kit 源码；本包配置同时检查 src/ 与 tests/，
  // 并与扩展共用 strict、noUncheckedIndexedAccess 与 noUnused* 约束。
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    // 本包源码由 Node 原生 ESM 直接加载，相对导入带 `.ts` 后缀，需显式允许
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
}
