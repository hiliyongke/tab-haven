{
  // 官网独立 TS 配置：不复用扩展的 .wxt/tsconfig.json。
  // 原因：那份配置是 WXT 为扩展生成的（含 chrome 类型、@/ 别名指向扩展 src），
  // 且 include 为仓库全量 —— 官网若被它收编，扩展与官网的类型口径会互相牵制。
  // 根 tsconfig.json 的 exclude 已把 site/ 排除，两边互不干扰。
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    // i18n-kit 的源码由 Node 直接加载（原生 ESM 不做扩展名补全），包内相对导入
    // 一律带 .ts 后缀；导入方需显式允许这种写法才能跟着检查包内代码。
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "site.config.ts"]
}
