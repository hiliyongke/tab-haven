# 工作区级 pnpm 配置。
#
# 只固化「改了就会出事」的行为，其余一律保持 pnpm 默认 —— 默认值变了由 pnpm 负责，
# 但下面这两条的失效会直接让依赖解析分叉或装不起来，值得写死。

# 自动安装缺失的 peer。
# 关掉会连第三方包的 peer 一起停装（如 vitest → @vitest/utils），直接起不来；
# 同时这也是 packages/i18n-kit 能解析到 react 的来源（react 是它的可选 peer）。
auto-install-peers=true

# 新增 workspace 依赖时写 `workspace:^`（随本地包版本滚动），而不是锁成具体版本号。
save-workspace-protocol=rolling
