{
  "name": "tabs",
  "description": "Tabs —— 本地优先、无账号无云端的标签工作台（浏览器侧边栏扩展）",
  "license": "MIT",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:compat": "cross-env TABS_VARIANT=compat wxt build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check:ui": "vitest run tests/ui/design-tokens.test.ts",
    "check:privacy": "node scripts/privacy-check.mjs",
    "check:i18n": "node scripts/i18n-dead-keys.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:i18n && npm run check:ui && npm run test && npm run build && npm run check:privacy",
    "zip": "wxt zip",
    "crx": "wxt build && node scripts/pack-crx.mjs"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=26"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "fuzzysort": "^4.0.2",
    "i18next": "^26.4.2",
    "lucide-react": "^1.41.0",
    "pinyin-pro": "^3.29.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "tldts": "^7.4.11",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
